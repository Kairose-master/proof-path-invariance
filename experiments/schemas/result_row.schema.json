{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPI next-token logit result row",
  "type": "object",
  "required": [
    "run_id",
    "pair_id",
    "variant",
    "gold",
    "yes_token_id",
    "no_token_id",
    "yes_logit",
    "no_logit",
    "margin",
    "predicted_answer"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "pair_id": {"type": "string"},
    "variant": {"type": "string", "enum": ["base", "premise_reverse"]},
    "gold": {"type": "boolean"},
    "yes_token_id": {"type": "integer", "minimum": 0},
    "no_token_id": {"type": "integer", "minimum": 0},
    "yes_logit": {"type": "number"},
    "no_logit": {"type": "number"},
    "margin": {"type": "number"},
    "predicted_answer": {"type": "string", "enum": ["YES", "NO", "TIE"]},
    "prompt_token_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
