{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPI logit-margin run manifest",
  "type": "object",
  "required": ["run_id", "benchmark", "model", "measurement", "execution"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "benchmark": {
      "type": "object",
      "required": ["name", "lock_file", "paired_prompts_sha256", "prompt_count"],
      "properties": {
        "name": {"type": "string"},
        "lock_file": {"type": "string"},
        "paired_prompts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_count": {"type": "integer", "const": 512}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "model_id", "revision", "resolved_commit", "access_date_utc"],
      "properties": {
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "revision": {"type": "string"},
        "resolved_commit": {"type": ["string", "null"]},
        "access_date_utc": {"type": "string"},
        "interface": {"type": "string"}
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "mode",
        "yes_candidate",
        "no_candidate",
        "require_single_token_candidates",
        "repeats_per_prompt"
      ],
      "properties": {
        "mode": {"type": "string", "const": "next_token_logit_margin"},
        "yes_candidate": {"type": "string", "const": " YES"},
        "no_candidate": {"type": "string", "const": " NO"},
        "require_single_token_candidates": {"type": "boolean", "const": true},
        "repeats_per_prompt": {"type": "integer", "const": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "runner_commit",
        "torch_version",
        "transformers_version",
        "device",
        "dtype",
        "started_at_utc",
        "finished_at_utc",
        "notes"
      ],
      "properties": {
        "runner_commit": {"type": "string"},
        "torch_version": {"type": ["string", "null"]},
        "transformers_version": {"type": ["string", "null"]},
        "device": {"type": "string"},
        "dtype": {"type": "string"},
        "started_at_utc": {"type": ["string", "null"]},
        "finished_at_utc": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "analysis_status": {
      "type": "string",
      "enum": ["planned", "collected", "validated", "analyzed"]
    }
  },
  "additionalProperties": false
}
